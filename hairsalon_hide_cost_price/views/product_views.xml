<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product form (also inherited by the product.product primary form) -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.hide.cost.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@id='standard_price_label']" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.list.hide.cost.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </field>
        </field>
    </record>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.easy.edit.hide.cost.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//div[field[@name='standard_price']]" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.hide.cost.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </field>
        </field>
    </record>
</odoo>
