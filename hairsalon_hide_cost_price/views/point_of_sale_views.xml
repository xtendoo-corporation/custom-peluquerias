<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Applied before other extensions (e.g. pos_conventional_core replaces
         the totals group that holds the margin). -->
    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.hide.cost.price</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='total_cost']"
                   position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//field[@name='lines']/list/field[@name='margin']"
                   position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//field[@name='lines']/list/field[@name='margin_percent']"
                   position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//label[@for='margin']" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
            <xpath expr="//div[field[@name='margin']]" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_pivot" model="ir.ui.view">
        <field name="name">pos.order.pivot.hide.cost.price</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_pivot"/>
        <field name="arch" type="xml">
            <field name="margin" position="attributes">
                <attribute name="groups">hairsalon_hide_cost_price.group_show_cost_price</attribute>
            </field>
            <field name="margin" position="after">
                <field name="margin" invisible="1" groups="!hairsalon_hide_cost_price.group_show_cost_price"/>
            </field>
        </field>
    </record>

    <!-- pos.order has no graph view: Odoo builds a default one offering every
         numeric field (margin included) as a measure. This view is equivalent
         to that default one but hides margin measures to restricted users. -->
    <record id="view_pos_order_graph" model="ir.ui.view">
        <field name="name">pos.order.graph.hide.cost.price</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <graph string="Point of Sale Orders">
                <field name="name"/>
                <field name="margin" invisible="1" groups="!hairsalon_hide_cost_price.group_show_cost_price"/>
                <field name="margin_percent" invisible="1" groups="!hairsalon_hide_cost_price.group_show_cost_price"/>
            </graph>
        </field>
    </record>

    <record id="view_report_pos_order_pivot" model="ir.ui.view">
        <field name="name">report.pos.order.pivot.hide.cost.price</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="margin" invisible="1" groups="!hairsalon_hide_cost_price.group_show_cost_price"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_pos_order_graph" model="ir.ui.view">
        <field name="name">report.pos.order.graph.hide.cost.price</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_graph"/>
        <field name="arch" type="xml">
            <graph position="inside">
                <field name="margin" invisible="1" groups="!hairsalon_hide_cost_price.group_show_cost_price"/>
            </graph>
        </field>
    </record>
</odoo>
