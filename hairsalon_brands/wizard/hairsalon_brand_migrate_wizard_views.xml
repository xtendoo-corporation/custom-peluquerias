<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="hairsalon_brand_migrate_wizard_form" model="ir.ui.view">
        <field name="name">hairsalon.brand.migrate.wizard.form</field>
        <field name="model">hairsalon.brand.migrate.wizard</field>
        <field name="arch" type="xml">
            <form string="Migrate Brands">
                <group invisible="state != 'draft'">
                    <div class="alert alert-info" role="alert">
                        <p> This wizard will create <strong>hairsalon.brand</strong> records from <strong>
                            x_marca</strong> and <strong>hairsalon.brand.line</strong> records from <strong>
                            x_linea</strong>, then assign them to each product. </p>
                    </div>
                </group>
                <group invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <p>
                            <strong>Migration completed successfully!</strong>
                        </p>
                    </div>
                    <group>
                        <field name="brand_count" />
                        <field name="line_count" />
                        <field name="product_count" />
                    </group>
                </group>
                <field name="state" invisible="1" />
                <footer>
                    <button name="action_migrate_brands"
                        string="Migrate Brands"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'" />
                    <button string="Close"
                        class="btn-secondary"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_hairsalon_brand_migrate_wizard" model="ir.actions.act_window">
        <field name="name">Migrate Brands</field>
        <field name="res_model">hairsalon.brand.migrate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under POS Configuration -->
    <!-- <menuitem id="menu_hairsalon_brand_migrate"
        name="Migrate Brands"
        parent="point_of_sale.menu_point_config_product"
        action="action_hairsalon_brand_migrate_wizard"
        sequence="100" /> -->

</odoo>