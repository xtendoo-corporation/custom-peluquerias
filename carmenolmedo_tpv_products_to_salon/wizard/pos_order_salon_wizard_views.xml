<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_salon_wizard_form" model="ir.ui.view">
        <field name="name">pos.order.salon.wizard.form</field>
        <field name="model">pos.order.salon.wizard</field>
        <field name="arch" type="xml">
            <form string="Transferir a Salón">
                <div class="alert alert-info" role="alert">
                    Selecciona los productos y las cantidades que deseas transferir al Salón como consumo interno.
                </div>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_accept" string="Aceptar y Transferir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
