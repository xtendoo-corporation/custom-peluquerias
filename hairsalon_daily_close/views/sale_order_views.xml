<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_pos_session" model="ir.ui.view">
        <field name="name">sale.order.form.pos.session</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="date_order" position="after">
                <field name="pos_session_id" invisible="not pos_session_id"/>
            </field>
        </field>
    </record>
</odoo>
