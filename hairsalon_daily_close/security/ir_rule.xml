<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_hairsalon_daily_close_sale_company" model="ir.rule">
        <field name="name">Daily close sales: multi-company</field>
        <field name="model_id" ref="model_hairsalon_daily_close_sale"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hairsalon_daily_close_payment_company" model="ir.rule">
        <field name="name">Daily close payments: multi-company</field>
        <field name="model_id" ref="model_hairsalon_daily_close_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
