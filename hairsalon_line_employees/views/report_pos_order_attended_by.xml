<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ticket 80mm: "Atendido por" muestra el empleado en lugar del usuario -->
    <template id="report_pos_order_80mm_attended_by"
              inherit_id="pos_conventional_receipt_custom.report_pos_order_80mm">
        <xpath expr="//span[@t-field='o.user_id.name']" position="replace">
            <span t-out="o.attended_by_id.name or o.user_id.name"/>
        </xpath>
    </template>

    <!-- Factura simplificada 80mm (account.move): empleado del pedido POS -->
    <template id="report_factura_simplificada_80mm_attended_by"
              inherit_id="pos_conventional_receipt_custom.report_factura_simplificada_80mm">
        <xpath expr="//span[@t-field='o.invoice_user_id.name']" position="replace">
            <span t-out="(o.pos_order_ids[:1].attended_by_id.name) or o.invoice_user_id.name"/>
        </xpath>
    </template>
</odoo>
