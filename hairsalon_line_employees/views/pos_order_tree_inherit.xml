<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_conventional_line_employees_inherit_pos_order_tree" model="ir.ui.view">
        <field name="name">pos.order.tree.employees_summary</field>
        <field name="model">pos.order</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <!-- Insert employees summary column (visible by default) -->
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="employee_names_summary"/>
                <field name="attended_by_id"/>
            </xpath>
            <!-- Eliminado xpath problemático que apuntaba a field[@name='employee_id'] en la vista padre.
                 La vista padre (point_of_sale.view_pos_order_tree) no contiene ese campo, lo que
                 provocaba un ParseError al cargar el módulo. Si en el futuro existe ese campo,
                 reintroducir un xpath correcto o crear la columna en la vista padre. -->
        </field>
    </record>
</odoo>
