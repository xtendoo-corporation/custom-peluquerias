<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_employees" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hairsalon.line.employees</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='tax_ids']" position="after">
                <field name="employee_ids" widget="many2many_tags" optional="show" options="{'no_create': True}" />
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='tax_ids']" position="after">
                <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}" />
            </xpath>
            <xpath expr="//field[@name='note']" position="before">
                <group>
                    <field name="employees_summary" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_employees" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.hairsalon.line.employees</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="employees_summary" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_employees" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.hairsalon.line.employees.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="employees_summary" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
